# --- обязательно
BOT_TOKEN=123456:ABC-токен_от_@BotFather
ADMIN_BOT_TOKEN=                   # второй бот от @BotFather только для владельца: уведомления + админка. Пусто — всё в одном боте
ADMIN_IDS=111111111                # твой Telegram ID (@getidsbot): сюда приходят уведомления и работает /admin
DB_PATH=/data/showcase.db          # на Railway добавь Volume с путём /data

# --- витрина
BRAND=Jack Bots                    # как подписан бот в приветствии
CONTACT=@твой_ник                  # куда писать по заказу (кнопка «Хочу такого бота»)
DEMO_MODE=true                     # показывать клиенту, какое уведомление получит владелец. Для боевого бота клиента — false

# --- под заказчика
PAYMENT_TOKEN=                     # токен оплаты из @BotFather → Payments (ЮKassa: сначала тестовый). Пусто — оплата при получении
TZ_OFFSET_HOURS=3                  # часовой пояс заведения
REMIND_BEFORE_MIN=120              # за сколько минут напоминать о записи
